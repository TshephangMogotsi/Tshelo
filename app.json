{
  "expo": {
    "name": "Tshelo",
    "slug": "tshelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "tshelo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a0f76b53-0427-41d9-b5a1-a59024570558"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datasentinels.tshelo",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.digitalnatives.tshelo",
      "permissions": ["android.permission.RECEIVE_SMS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7439E0"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Tshelo to access your contacts so you can add organisers from your phone book."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0f76b53-0427-41d9-b5a1-a59024570558"
      }
    },
    "owner": "digital-natives"
  }
}
