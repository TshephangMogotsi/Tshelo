# Required public application configuration. These values are embedded in the
# client bundle, so never place service-role keys or other secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_API_BASE_URL=https://tshelo-admin.vercel.app

# Required before public store submission.
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://your-domain.example/terms
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacy

# Optional until token checkout is approved and live.
EXPO_PUBLIC_TOKEN_PORTAL_URL=https://your-domain.example/tokens
